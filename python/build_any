#!/usr/bin/env python
from __future__ import print_function

import argparse
import os
import platform
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import textwrap
import urllib
import zipfile

try:
    from urllib.request import urlopen
except ImportError:
    from urllib2 import urlopen

try:
    from shutil import which as find_executable
except ImportError:
    from distutils.spawn import find_executable

IS_WINDOWS = platform.system() == 'Windows'


def info(msg):
    print('[i] ' + msg)


def warn(msg):
    print('[!] ' + msg)


def err(msg):
    print('[x] ' + msg, file=sys.stderr)


def run(cmd, cwd=None, check=True, capture=False):
    if isinstance(cmd, str):
        cmd = shlex.split(cmd)
    if cwd:
        info('$ ' + ' '.join(shlex.quote(c) for c in cmd) + '   (cwd=' + str(cwd) + ')')
    else:
        info('$ ' + ' '.join(shlex.quote(c) for c in cmd))
    if capture:
        proc = subprocess.Popen(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        out, _ = proc.communicate()
        if check and proc.returncode != 0:
            raise subprocess.CalledProcessError(proc.returncode, cmd, output=out)
        return out
    proc = subprocess.Popen(cmd, cwd=cwd)
    proc.communicate()
    if check and proc.returncode != 0:
        raise subprocess.CalledProcessError(proc.returncode, cmd)
    return proc.returncode


def have(tool):
    return find_executable(tool) is not None


def nproc():
    try:
        return os.cpu_count() or 1
    except Exception:
        return 1


def download(url, dest_dir):
    name = url.split('?')[0].rstrip('/').split('/')[-1] or 'download'
    out = os.path.join(dest_dir, name)
    if url.startswith('file://'):
        src = url[7:]
        info('Copying local file: ' + src)
        shutil.copy2(src, out)
        return out
    if os.path.isfile(url):
        info('Copying local file: ' + url)
        shutil.copy2(url, out)
        return out
    info('Downloading ' + url)
    try:
        response = urlopen(url)
        with open(out, 'wb') as f:
            shutil.copyfileobj(response, f)
        return out
    except Exception as exc:
        err('Download failed: ' + str(exc))
        sys.exit(2)


def extract(archive, dest):
    info('Extracting ' + os.path.basename(archive))
    if not os.path.isdir(dest):
        os.makedirs(dest)
    before = set(os.listdir(dest))
    try:
        if zipfile.is_zipfile(archive):
            with zipfile.ZipFile(archive, 'r') as zf:
                zf.extractall(dest)
        elif tarfile.is_tarfile(archive):
            with tarfile.open(archive, 'r:*') as tf:
                tf.extractall(dest)
        else:
            err('Unrecognised archive format: ' + archive)
            sys.exit(2)
    except Exception as exc:
        err('Extraction failed: ' + str(exc))
        sys.exit(2)
    after = set(os.listdir(dest))
    new_items = list(after - before)
    if len(new_items) == 1 and os.path.isdir(os.path.join(dest, new_items[0])):
        return os.path.join(dest, new_items[0])
    return dest


def default_dest():
    home = os.path.expanduser('~')
    desktop = os.path.join(home, 'Desktop')
    if os.path.isdir(desktop):
        return desktop
    return os.path.join(home, 'bin')


def find_binary(prefix, name_hint):
    candidates = []
    for d in [os.path.join(prefix, 'bin'), os.path.join(prefix, 'sbin'), prefix]:
        if os.path.isdir(d):
            for name in os.listdir(d):
                full = os.path.join(d, name)
                if os.path.isfile(full) and os.access(full, os.X_OK):
                    if IS_WINDOWS and not name.lower().endswith(('.exe', '.bat', '.cmd')):
                        continue
                    candidates.append(full)
    if not candidates:
        return None
    if name_hint:
        for c in candidates:
            if os.path.basename(c).split('.')[0] == name_hint or os.path.basename(c) == name_hint:
                return c
    return candidates[0]


def try_recipe(src, prefix, jobs):
    recipes = [
        ('cmake', ['cmake'], ['cmake', '-S', src, '-B', os.path.join(src, 'build'), '-DCMAKE_INSTALL_PREFIX=' + prefix, '-DCMAKE_BUILD_TYPE=Release'], ['cmake', '--build', os.path.join(src, 'build'), '--parallel', str(jobs)], ['cmake', '--install', os.path.join(src, 'build')]),
        ('autotools', ['make'], ['./configure', '--prefix=' + prefix], ['make', '-j' + str(jobs)], ['make', 'install']),
        ('python', [sys.executable], [sys.executable, '-m', 'pip', 'install', '--prefix', prefix, '.'], [], []),
    ]
    for name, required, build_cmd, compile_cmd, install_cmd in recipes:
        if any(not have(tool) for tool in required):
            continue
        build_dir = src
        if name == 'cmake':
            build_dir = os.path.join(src, 'build')
        try:
            if build_cmd:
                try:
                    run(build_cmd, cwd=src)
                except Exception:
                    continue
            if compile_cmd:
                try:
                    run(compile_cmd, cwd=src)
                except Exception:
                    pass
            if install_cmd:
                try:
                    run(install_cmd, cwd=src)
                except Exception:
                    pass
            return name
        except Exception:
            continue
    return None


def manual_build(src, prefix):
    print()
    warn('No automatic recipe worked.')
    print(textwrap.dedent('''
        Please help me build this project.

        Source directory: {0}
        Install prefix:   {1}

        Enter the shell command to build and install.
        Or leave blank to abort.
    '''.format(src, prefix)))
    try:
        cmd = raw_input('Build command> ').strip()
    except NameError:
        cmd = input('Build command> ').strip()
    if not cmd:
        return None
    try:
        run(cmd, cwd=src)
    except Exception as exc:
        err('Manual build failed: ' + str(exc))
        return None
    try:
        if sys.version_info[0] < 3:
            path = raw_input('Path to resulting binary> ').strip()
        else:
            path = input('Path to resulting binary> ').strip()
    except EOFError:
        return None
    if not path:
        return None
    p = os.path.expanduser(path)
    if not os.path.isabs(p):
        p = os.path.abspath(os.path.join(src, p))
    if not os.path.exists(p):
        err('Path does not exist: ' + p)
        return None
    return p


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    ap = argparse.ArgumentParser(description='Download, build, and install a source project.')
    ap.add_argument('source', help='URL, local archive, or extracted directory')
    ap.add_argument('--name', help='Name of the binary to look for')
    ap.add_argument('--dest', help='Where to place the final binary')
    ap.add_argument('--prefix', help='Install prefix to use during build')
    ap.add_argument('--jobs', type=int, default=nproc(), help='Parallel build jobs')
    ap.add_argument('--keep-tmp', action='store_true', help='Keep temporary files')
    ap.add_argument('--dry-run', action='store_true', help='Only print actions')
    args = ap.parse_args(argv)

    dest = args.dest or default_dest()
    if not os.path.isdir(dest):
        os.makedirs(dest)
    info('Final destination: ' + dest)

    if args.dry_run:
        info('Dry run: would download, extract, build, and install.')
        return 0

    tmp = tempfile.mkdtemp(prefix='build_any_')
    info('Working directory: ' + tmp)
    try:
        src = args.source
        if os.path.isdir(src):
            source_dir = os.path.abspath(src)
            info('Using existing source directory: ' + source_dir)
        else:
            archive = download(src, tmp)
            source_dir = extract(archive, os.path.join(tmp, 'src'))

        name_hint = args.name or os.path.basename(source_dir).split('-')[0].split('_')[0]
        prefix = args.prefix or os.path.join(tmp, 'install')
        if not os.path.isdir(prefix):
            os.makedirs(prefix)

        chosen = try_recipe(source_dir, prefix, args.jobs)
        built_binary = None
        if chosen:
            info('Build succeeded using recipe: ' + chosen)
            built_binary = find_binary(prefix, name_hint)
        if built_binary is None:
            built_binary = manual_build(source_dir, prefix)
        if built_binary is None:
            err('No binary produced. Aborting.')
            return 1

        final = os.path.join(dest, os.path.basename(built_binary))
        info('Installing ' + built_binary + ' -> ' + final)
        shutil.copy2(built_binary, final)
        try:
            os.chmod(final, os.stat(final).st_mode | 0o111)
        except Exception:
            pass
        print('Done. Installed: ' + final)
        return 0
    finally:
        if not args.keep_tmp:
            shutil.rmtree(tmp, ignore_errors=True)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        err('Interrupted.')
        sys.exit(130)

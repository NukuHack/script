#!/usr/bin/env python
import os
import sys
import subprocess

def main():
    here = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
    target = os.path.join(here, "cbuild.py")
    if not os.path.isfile(target):
        sys.stderr.write("error: %s not found in %s\n" %
                         (os.path.basename(target), here))
        return 1

    argv = [sys.executable, target] + sys.argv[1:]
    if os.name == "posix":
        os.execv(sys.executable, argv)           # never returns
    sys.exit(subprocess.call(argv))

if __name__ == "__main__":
    sys.exit(main())
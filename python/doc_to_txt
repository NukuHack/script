#!/usr/bin/env python
from __future__ import print_function

import argparse
import io
import os
import re
import sys
import zipfile

try:
    from html import unescape as html_unescape
except ImportError:
    try:
        from HTMLParser import HTMLParser
    except ImportError:
        HTMLParser = None

    def html_unescape(s):
        if HTMLParser is not None:
            class _H(HTMLParser):
                def __init__(self):
                    HTMLParser.__init__(self)
                    self.result = ''
                def handle_data(self, data):
                    self.result += data
            h = _H()
            h.feed(s)
            return h.result
        return s


def read_text(path):
    with io.open(path, 'rb') as f:
        data = f.read()
    for enc in ('utf-8', 'utf-16', 'latin-1'):
        try:
            return data.decode(enc)
        except UnicodeDecodeError:
            continue
    return data.decode('utf-8', 'replace')


def strip_tags(text):
    text = re.sub(r'<script.*?</script>', ' ', text, flags=re.I | re.S)
    text = re.sub(r'<style.*?</style>', ' ', text, flags=re.I | re.S)
    text = re.sub(r'<[^>]+>', ' ', text)
    text = re.sub(r'\s+', ' ', text)
    return text.strip()


def extract_html_text(path):
    text = read_text(path)
    text = html_unescape(text)
    return strip_tags(text)


def extract_docx_text(path):
    try:
        with zipfile.ZipFile(path, 'r') as zf:
            doc = zf.read('word/document.xml')
    except Exception:
        return ''
    pieces = re.findall(r'<w:t[^>]*>(.*?)</w:t>', doc.decode('utf-8', 'replace'), re.S)
    text = ''.join(pieces)
    return re.sub(r'\s+', ' ', text)


def extract_odt_text(path):
    try:
        with zipfile.ZipFile(path, 'r') as zf:
            xml = zf.read('content.xml')
    except Exception:
        return ''
    text = xml.decode('utf-8', 'replace')
    pieces = re.findall(r'<text:p[^>]*>(.*?)</text:p>', text, re.S)
    content = ' '.join(re.sub(r'<[^>]+>', ' ', p) for p in pieces)
    return re.sub(r'\s+', ' ', content)


def extract_text(path):
    ext = os.path.splitext(path)[1].lower()
    if ext in ('.txt', '.md', '.rst', '.log', '.ini', '.cfg', '.conf', '.csv', '.json'):
        return read_text(path)
    if ext in ('.html', '.htm'):
        return extract_html_text(path)
    if ext == '.docx':
        return extract_docx_text(path)
    if ext == '.odt':
        return extract_odt_text(path)
    with io.open(path, 'rb') as f:
        data = f.read()
    return data.decode('utf-8', 'replace')


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    ap = argparse.ArgumentParser(description='Convert common document formats to plain text.')
    ap.add_argument('input', help='input file path')
    ap.add_argument('output', nargs='?', help='output text file (optional)')
    args = ap.parse_args(argv)

    text = extract_text(args.input)
    if args.output:
        with io.open(args.output, 'w', encoding='utf-8') as out:
            out.write(text)
        print('Wrote: ' + args.output)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == '__main__':
    sys.exit(main())

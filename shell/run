#!/bin/bash
set -e

usage() {
    cat >&2 <<'USAGE'
Usage: run.sh [-main FUNCTION] [-Xcc FLAG]... INPUT...

  INPUT     One or more C source files. Each one is compiled individually
            into its own object file, then all the objects are linked
            together into a single program which is run.

  -main FUNCTION
            Optional. If given (and not literally "main"), the main()
            of every input file is renamed out of the way and a tiny
            driver calls FUNCTION() instead. FUNCTION is expected to be
            the one defined in the first input file.

  -Xcc FLAG Pass FLAG to the compiler and linker (e.g. -Xcc -O3
            -Xcc -march=native -Xcc -ffast-math). May be repeated.

Binary is built in a temp dir and removed when this script exits.
USAGE
}

FUNCTION=""
INPUTS=()
CFLAGS_EXTRA=()

while [ $# -gt 0 ]; do
    case "$1" in
        -main)
            if [ $# -lt 2 ]; then
                echo "run.sh: -main requires a function name" >&2
                exit 1
            fi
            FUNCTION="$2"
            shift 2
            ;;
        -Xcc)
            if [ $# -lt 2 ]; then
                echo "run.sh: -Xcc requires an argument" >&2
                exit 1
            fi
            CFLAGS_EXTRA+=("$2")
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            while [ $# -gt 0 ]; do
                INPUTS+=("$1")
                shift
            done
            ;;
        -*)
            echo "run.sh: unknown option: $1" >&2
            usage
            exit 1
            ;;
        *)
            INPUTS+=("$1")
            shift
            ;;
    esac
done

if [ "${#INPUTS[@]}" -eq 0 ]; then
    usage
    exit 1
fi

TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT

BIN="$TMPDIR/a.out"
OBJECTS=()

USE_DRIVER=0
if [ -n "$FUNCTION" ] && [ "$FUNCTION" != "main" ]; then
    USE_DRIVER=1
fi

if [ "$USE_DRIVER" -eq 1 ]; then
    echo "Compiling ${#INPUTS[@]} file(s) (entry: $FUNCTION) -> temp binary"
else
    echo "Compiling ${#INPUTS[@]} file(s) -> temp binary"
fi

i=0
for src in "${INPUTS[@]}"; do
    obj="$TMPDIR/input$i.o"
    OBJECTS+=("$obj")

    if [ "$USE_DRIVER" -eq 1 ]; then
        # Rename this file's own main() out of the way. The name is made
        # unique per file so several files can each have a main() without
        # clashing at link time.
        gcc -c "$src" -o "$obj" \
            -Dmain="__unused_main_${i}__" \
            -W -Wall -Wextra -pedantic \
            "${CFLAGS_EXTRA[@]}"
    else
        gcc -c "$src" -o "$obj" \
            -W -Wall -Wextra -pedantic \
            "${CFLAGS_EXTRA[@]}"
    fi

    i=$((i + 1))
done

if [ "$USE_DRIVER" -eq 1 ]; then
    cat > "$TMPDIR/driver.c" <<EOF
/* auto-generated driver: calls $FUNCTION() as the entry point */
extern int $FUNCTION(void);

int main(void) {
    return $FUNCTION();
}
EOF

    gcc -c "$TMPDIR/driver.c" -o "$TMPDIR/driver.o" \
        -W -Wall -Wextra -pedantic \
        "${CFLAGS_EXTRA[@]}"

    OBJECTS+=("$TMPDIR/driver.o")
fi

# -lm at link time so math functions (sqrtf, expf, logf, ...) resolve.
gcc "${OBJECTS[@]}" -o "$BIN" "${CFLAGS_EXTRA[@]}" -lm

"$BIN"